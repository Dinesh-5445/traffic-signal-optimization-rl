# ============================================================
# Traffic Signal Optimization — .gitignore
# Python + Eclipse SUMO + Stable-Baselines3
# ============================================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# ----------------------------
# Test / type check caches
# ----------------------------
.pytest_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ----------------------------
# Virtual environments
# ----------------------------
.venv/
venv/
env.bak/
venv.bak/
Pipfile.lock

# ----------------------------
# Environment & secrets
# ----------------------------
.env
.env.*
*.env
secrets.yaml
secrets.json

# ----------------------------
# IDEs & editors
# ----------------------------
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docview
*.iml
.project
.settings/
.classpath
*.swp
*.swo
*~

# ----------------------------
# OS-specific
# ----------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----------------------------
# TensorBoard logs
# (Large binary event files — regenerated by training)
# ----------------------------
results/tensorboard/

# ----------------------------
# Trained model artifacts
# (Large binary files — regenerated by training)
# Committed only when publishing a release checkpoint.
# ----------------------------
results/models/*.zip
results/models/*.pkl

# ----------------------------
# SUMO simulation output
# (Auto-generated — not source files)
# ----------------------------
networks/results/
*.xml.bak
*.net.xml.bak
tripinfo*.xml
summary*.xml
emission*.xml
*.log
*.sumocfg.bak

# ----------------------------
# Temporary & misc
# ----------------------------
*.tmp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/
